{
  "name": "dsh-meta-team",
  "version": "0.1.1",
  "repository": { "type": "git", "url": "git+https://github.com/yangjingbo123/dsh-metateam.git" },
  "homepage": "https://github.com/yangjingbo123/dsh-metateam#readme",
  "bugs": { "url": "https://github.com/yangjingbo123/dsh-metateam/issues" },
  "keywords": ["dsh-plugin", "deepseek-harness", "multi-agent", "self-improvement", "meta-team"],
  "description": "DeepSeek Harness 外置多智能体 RSI 实验插件：成员反思、交互演化与团队版本管理。",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.js", "dist/engine.js", "dist/store.js", "dist/types.js", "dist/control.js",
    "plugins/meta-team/resources/upstream.json", "examples/", "python/", "cordis.patch.yml", "README.md"
  ],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "engines": { "node": ">=24.9.0" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.4 || 0.2.2-rc.5",
    "@deepseek-ai/dsh-brand": "0.2.2-rc.4 || 0.2.2-rc.5",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.4 || 0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.4 || 0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.4 || 0.2.2-rc.5",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.4 || 0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.4 || 0.2.2-rc.5"
  },
  "dependencies": { "js-yaml": "4.3.2" },
  "devDependencies": {
    "@types/js-yaml": "4.0.9", "@types/node": "22.20.1", "typescript": "6.0.3"
  },
  "scripts": {
    "build": "node scripts/build-resources.mjs && node node_modules/typescript/bin/tsc -p tsconfig.json",
    "test": "node --test plugins/meta-team/test/*.test.ts",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test:dsh": "python3 scripts/smoke-dsh-plugin.py",
    "test:dsh:scripted": "python3 scripts/smoke-dsh-plugin.py --scripted"
  }
}
